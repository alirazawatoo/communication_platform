# Provider credentials. Leave one blank to skip that provider.
SG_KEY=
POSTMARK_TOKEN=

# PostgreSQL connection (Compose sets db_host itself)
db_host=localhost
db_port=5432
db_username=postgres
db_password=change-me
RACK_ENV=development

# Optional HTTP basic auth for /sg_webhook and /pm_webhook
WEBHOOK_USERNAME=
WEBHOOK_PASSWORD=

# Optional provider endpoint overrides (sandboxes, local fakes)
# SENDGRID_API_URL=https://api.sendgrid.com/v3/mail/send
# POSTMARK_API_URL=https://api.postmarkapp.com/email
